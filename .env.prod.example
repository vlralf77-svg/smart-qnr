# SmartQnR 운영 환경변수 예시 — .env 로 복사 후 실제 값으로 채우세요.
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# ⚠️ 이 파일에는 절대 실제 시크릿을 커밋하지 마세요(.env 는 .gitignore).

# --- DB ---
DB_NAME=smartqnr
DB_USER=smartqnr
# 강력한 무작위 비밀번호:  openssl rand -base64 24
DB_PASSWORD=__set_strong_password__

# --- 백엔드 보안 ---
# JWT 서명키(32바이트 이상 랜덤):  openssl rand -base64 48
JWT_SECRET=__set_long_random_secret__
JWT_EXPIRY_HOURS=8

# 관리자 비밀번호 BCrypt 해시(평문 대신). 생성:
#   htpasswd -bnBC 12 "" '실제비밀번호' | tr -d ':\n'
#   (또는 docs/SECURITY.md 의 방법 참고)
AUTH_USER=admin
AUTH_PASSWORD_HASH=$2a$12$__replace_with_bcrypt_hash__

# 응답 데이터 암호화 키(AES-256, Base64 32바이트):  openssl rand -base64 32
DATA_ENCRYPTION_KEY=__set_base64_32byte_key__

# CORS 허용 도메인(콤마 구분). 실제 서비스 도메인만.
CORS_ALLOWED_ORIGINS=https://qnr.hospital.example.com

# 로그인 잠금 정책
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10

# 운영에서는 스키마 자동변경 금지(검증만)
JPA_DDL_AUTO=validate

# 브라우저는 같은 오리진(/api)으로 호출 → 비워둠
VITE_API_BASE_URL=
