-- ─────────────────────────────────────────────────────────────
-- 추가 솔루션용 DB 분리 초기화 (같은 Postgres 인스턴스 재사용)
--
--   SmartQnR 와 데이터를 "데이터베이스 + 계정" 단위로 격리한다.
--   실행 방법(예: 이미 떠 있는 db 컨테이너에서):
--     docker exec -i smartqnr-db psql -U smartqnr -d postgres \
--       < scripts/init-extra-solutions.sql
--
--   ※ 비밀번호는 반드시 .env / secret 로 교체할 것.
-- ─────────────────────────────────────────────────────────────

-- 케이스 1) 자체 서비스
CREATE USER solution_a WITH PASSWORD 'change-me';
CREATE DATABASE solution_a OWNER solution_a;
GRANT ALL PRIVILEGES ON DATABASE solution_a TO solution_a;

-- 케이스 2) 벤더 이미지
CREATE USER solution_b WITH PASSWORD 'change-me';
CREATE DATABASE solution_b OWNER solution_b;
GRANT ALL PRIVILEGES ON DATABASE solution_b TO solution_b;

-- ── 대안: DB 를 나누지 않고 "스키마"로만 분리하고 싶을 때 ──
--   \c smartqnr
--   CREATE SCHEMA solution_a AUTHORIZATION solution_a;
--
-- ── 특수 케이스: 벤더가 다른 엔진(MySQL 등)을 요구하면 ──
--   docker-compose.ext.yml 에 별도 db2 컨테이너를 추가하고
--   solution-b 의 접속 정보를 db2 로 돌린다(같은 Postgres 미사용).
