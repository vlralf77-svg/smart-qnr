# SmartQnR 서버 스택 환경변수 (docker compose 용)
# 실제 운영에서는 이 파일을 .env 로 복사한 뒤 값을 바꾸세요.

# --- DB ---
DB_NAME=smartqnr
DB_USER=smartqnr
DB_PASSWORD=change-this-db-password
DB_PORT=5432

# --- 백엔드(WAS) ---
BACKEND_PORT=8080
JPA_DDL_AUTO=update
# 로그인 계정(프론트와 동일해야 함)
AUTH_USER=admin
AUTH_PASSWORD=lit123qwe!
# 반드시 강력한 랜덤 값으로 교체
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRY_HOURS=12

# --- 웹(nginx) ---
WEB_PORT=8081
# 브라우저가 같은 오리진(/api)으로 호출 → 비워두면 nginx 가 백엔드로 프록시
VITE_API_BASE_URL=

# --- 서버 간 통신 HTTPS (nginx → backend, 운영/prod 오버레이에서 사용) ---
# scripts/gen-internal-certs.sh 로 ./certs/backend-keystore.p12 · internal-ca.pem 생성 후 설정.
# 스크립트가 비밀번호를 자동 생성하면 출력된 값을 여기에 붙여넣으세요.
SERVER_SSL_KEY_STORE_PASSWORD=change-this-keystore-password
SERVER_SSL_KEY_ALIAS=smartqnr-backend
